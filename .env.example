PORT=8080
API_TOKEN=replace-with-a-long-random-token
# Preferred: Google user OAuth for personal My Drive uploads. Set all three.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Fallback service-account credentials. Service accounts cannot upload to
# personal My Drive folders unless using a shared folder/Shared Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or a path inside the container to a mounted key file.
GOOGLE_APPLICATION_CREDENTIALS=
# Folder shared with the service account. Archives go under
# {this folder}/YouTube Playlist Archives/{playlist name}
DRIVE_ROOT_FOLDER_ID=
DATA_DIR=/data
# Optional extra yt-dlp args, shell-quoted. Example: --cookies /data/cookies.txt
YTDLP_EXTRA_ARGS=
# In-process daily check in TZ (default America/New_York). Empty disables it.
DAILY_CHECK_TIME=08:22
TZ=America/New_York
# Set to 1 on a Railway cron service so the process checks once and exits.
CRON_MODE=
